# API keys and tokens for the sample sandboxes.
# Loaded into the sandboxes via `env_file: sample.env` in sandbox.yml.
# Fill in the ones you need — unused keys can stay as placeholders.
#
# This file is intentionally named `sample.env` (not `.env`) so it is tracked.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
CURSOR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
