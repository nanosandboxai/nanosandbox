+/* ── Next-mode: extra virtiofs mounts ──────────────────────────────────── */
+
+/*
+ * Parse KRUN_EXTRA_MOUNTS JSON array and mount each entry.
+ * Each entry: {"tag":"<tag>","target":"<path>","readonly":true|false}
+ * Returns 0 on success, -1 on error.
+ */
+static int mount_extra_virtiofs(void)
+{
+    const char *extra_mounts_env = getenv("KRUN_EXTRA_MOUNTS");
+    if (!extra_mounts_env) {
+        return 0; /* nothing to do */
+    }
+
+    jsmn_parser parser;
+    jsmntok_t tokens[256];
+    char *data;
+    int num_tokens;
+    int ret = -1;
+
+    data = strdup(extra_mounts_env);
+    if (!data) {
+        printf("mount_extra_virtiofs: strdup failed\n");
+        return -1;
+    }
+
+    jsmn_init(&parser);
+    num_tokens = jsmn_parse(&parser, data, strlen(data), tokens, 256);
+    if (num_tokens < 1 || tokens[0].type != JSMN_ARRAY) {
+        printf("mount_extra_virtiofs: KRUN_EXTRA_MOUNTS must be a JSON array\n");
+        goto cleanup;
+    }
+
+    /* Iterate over array elements (each is an object) */
+    int tok_idx = 1;
+    for (int elem = 0; elem < tokens[0].size; elem++) {
+        if (tok_idx >= num_tokens || tokens[tok_idx].type != JSMN_OBJECT) {
+            printf("mount_extra_virtiofs: expected object at element %d\n", elem);
+            goto cleanup;
+        }
+
+        char *tag = NULL;
+        char *target = NULL;
+        int readonly = 0;
+        int n_obj_tokens = tokens[tok_idx].size;
+
+        tok_idx++; /* move past the object token */
+        for (int prop = 0; prop < n_obj_tokens * 2 && tok_idx < num_tokens; prop++) {
+            if (jsoneq(data, &tokens[tok_idx], "tag") == 0) {
+                tok_idx++;
+                int len = tokens[tok_idx].end - tokens[tok_idx].start;
+                tag = strndup(data + tokens[tok_idx].start, len);
+                tok_idx++;
+            } else if (jsoneq(data, &tokens[tok_idx], "target") == 0) {
+                tok_idx++;
+                int len = tokens[tok_idx].end - tokens[tok_idx].start;
+                target = strndup(data + tokens[tok_idx].start, len);
+                tok_idx++;
+            } else if (jsoneq(data, &tokens[tok_idx], "readonly") == 0) {
+                tok_idx++;
+                int len = tokens[tok_idx].end - tokens[tok_idx].start;
+                if (len == 4 && strncmp(data + tokens[tok_idx].start, "true", 4) == 0) {
+                    readonly = 1;
+                }
+                tok_idx++;
+            } else {
+                /* Skip unknown key and its value */
+                tok_idx += 2;
+            }
+        }
+
+        if (!tag || !target) {
+            printf("mount_extra_virtiofs: mount %d missing 'tag' or 'target'\n", elem);
+            free(tag);
+            free(target);
+            goto cleanup;
+        }
+
+        /* Create target directory */
+        if (mkdir(target, 0755) < 0 && errno != EEXIST) {
+            printf("mount_extra_virtiofs: mkdir(%s) failed: %s\n", target, strerror(errno));
+            free(tag);
+            free(target);
+            goto cleanup;
+        }
+
+        /* Mount virtiofs */
+        char mount_opts[4096];
+        snprintf(mount_opts, sizeof(mount_opts), "tag=%s", tag);
+
+        unsigned long mountflags = 0;
+        if (readonly) {
+            mountflags |= MS_RDONLY;
+        }
+
+        printf("Mounting virtiofs tag='%s' at '%s' (readonly=%d)\n", tag, target, readonly);
+        if (mount("virtiofs", target, "virtiofs", mountflags, mount_opts) < 0) {
+            printf("mount_extra_virtiofs: mount(%s at %s) failed: %s\n",
+                   tag, target, strerror(errno));
+            free(tag);
+            free(target);
+            goto cleanup;
+        }
+
+        printf("Mounted virtiofs '%s' at '%s'\n", tag, target);
+        free(tag);
+        free(target);
+    }
+
+    ret = 0;
+
+cleanup:
+    free(data);
+    return ret;
+}
+
+#include <linux/route.h>
+
+/* ── Next-mode: static network bring-up ────────────────────────────────── */
+
+/*
+ * Parse KRUN_NET_CONFIG JSON object and configure eth0 statically.
+ * Format: {"ip":"192.168.127.2/24","gateway":"192.168.127.1","dns":["8.8.8.8"]}
+ * Returns 0 on success, -1 on error.
+ */
+static int configure_static_network(void)
+{
+    const char *net_config_env = getenv("KRUN_NET_CONFIG");
+    if (!net_config_env) {
+        return 0; /* nothing to do */
+    }
+
+    jsmn_parser parser;
+    jsmntok_t tokens[128];
+    char *data;
+    int num_tokens;
+    int ret = -1;
+    char *ip_cidr = NULL;
+    char *gateway = NULL;
+    char *dns_servers = NULL;
+
+    data = strdup(net_config_env);
+    if (!data) {
+        printf("configure_static_network: strdup failed\n");
+        return -1;
+    }
+
+    jsmn_init(&parser);
+    num_tokens = jsmn_parse(&parser, data, strlen(data), tokens, 128);
+    if (num_tokens < 1 || tokens[0].type != JSMN_OBJECT) {
+        printf("configure_static_network: KRUN_NET_CONFIG must be a JSON object\n");
+        goto cleanup;
+    }
+
+    for (int i = 1; i < num_tokens; i += 2) {
+        if (jsoneq(data, &tokens[i], "ip") == 0 && (i + 1) < num_tokens) {
+            int len = tokens[i + 1].end - tokens[i + 1].start;
+            ip_cidr = strndup(data + tokens[i + 1].start, len);
+        } else if (jsoneq(data, &tokens[i], "gateway") == 0 && (i + 1) < num_tokens) {
+            int len = tokens[i + 1].end - tokens[i + 1].start;
+            gateway = strndup(data + tokens[i + 1].start, len);
+        } else if (jsoneq(data, &tokens[i], "dns") == 0 && (i + 1) < num_tokens) {
+            /* DNS is an array of strings — join with space for resolv.conf */
+            if (tokens[i + 1].type == JSMN_ARRAY) {
+                int arr_start = i + 2;
+                int arr_end = arr_start + tokens[i + 1].size;
+                size_t total = 0;
+                for (int j = arr_start; j < arr_end && j < num_tokens; j++) {
+                    int len = tokens[j].end - tokens[j].start;
+                    total += len + 1; /* space or null */
+                }
+                dns_servers = calloc(1, total + 1);
+                if (dns_servers) {
+                    size_t pos = 0;
+                    for (int j = arr_start; j < arr_end && j < num_tokens; j++) {
+                        int len = tokens[j].end - tokens[j].start;
+                        if (pos > 0) dns_servers[pos++] = ' ';
+                        memcpy(dns_servers + pos, data + tokens[j].start, len);
+                        pos += len;
+                    }
+                }
+                i += 1 + tokens[i + 1].size;
+            }
+        }
+    }
+
+    if (!ip_cidr) {
+        printf("configure_static_network: missing 'ip' field\n");
+        goto cleanup;
+    }
+
+    /* Parse IP/CIDR */
+    char ip_str[64];
+    int prefix_len = 24;
+    char *slash = strchr(ip_cidr, '/');
+    if (slash) {
+        *slash = '\0';
+        strncpy(ip_str, ip_cidr, sizeof(ip_str) - 1);
+        prefix_len = atoi(slash + 1);
+    } else {
+        strncpy(ip_str, ip_cidr, sizeof(ip_str) - 1);
+    }
+    ip_str[sizeof(ip_str) - 1] = '\0';
+
+    /* Compute netmask from prefix length */
+    struct in_addr netmask_addr;
+    uint32_t mask = prefix_len ? ~((1 << (32 - prefix_len)) - 1) : 0;
+    netmask_addr.s_addr = htonl(mask);
+
+    /* Open a socket for ioctl */
+    int sockfd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (sockfd < 0) {
+        perror("configure_static_network: socket");
+        goto cleanup;
+    }
+
+    struct ifreq ifr;
+    memset(&ifr, 0, sizeof(ifr));
+    strncpy(ifr.ifr_name, "eth0", IFNAMSIZ);
+
+    /* Bring eth0 up */
+    if (ioctl(sockfd, SIOCGIFFLAGS, &ifr) == 0) {
+        ifr.ifr_flags |= IFF_UP;
+        if (ioctl(sockfd, SIOCSIFFLAGS, &ifr) < 0) {
+            perror("configure_static_network: SIOCSIFFLAGS");
+            close(sockfd);
+            goto cleanup;
+        }
+    }
+
+    /* Set IP address */
+    struct sockaddr_in *addr = (struct sockaddr_in *)&ifr.ifr_addr;
+    addr->sin_family = AF_INET;
+    if (inet_pton(AF_INET, ip_str, &addr->sin_addr) <= 0) {
+        printf("configure_static_network: invalid IP '%s'\n", ip_str);
+        close(sockfd);
+        goto cleanup;
+    }
+    if (ioctl(sockfd, SIOCSIFADDR, &ifr) < 0) {
+        perror("configure_static_network: SIOCSIFADDR");
+        close(sockfd);
+        goto cleanup;
+    }
+
+    /* Set netmask */
+    struct sockaddr_in *nm = (struct sockaddr_in *)&ifr.ifr_netmask;
+    nm->sin_family = AF_INET;
+    nm->sin_addr = netmask_addr;
+    if (ioctl(sockfd, SIOCSIFNETMASK, &ifr) < 0) {
+        perror("configure_static_network: SIOCSIFNETMASK");
+        close(sockfd);
+        goto cleanup;
+    }
+
+    close(sockfd);
+
+    /* Set default gateway via route ioctl */
+    if (gateway) {
+        int rt_sockfd = socket(AF_INET, SOCK_DGRAM, 0);
+        if (rt_sockfd >= 0) {
+            struct rtentry route;
+            memset(&route, 0, sizeof(route));
+
+            struct sockaddr_in *rt_dst = (struct sockaddr_in *)&route.rt_dst;
+            rt_dst->sin_family = AF_INET;
+            rt_dst->sin_addr.s_addr = INADDR_ANY;
+
+            struct sockaddr_in *rt_gw = (struct sockaddr_in *)&route.rt_gateway;
+            rt_gw->sin_family = AF_INET;
+            inet_pton(AF_INET, gateway, &rt_gw->sin_addr);
+
+            struct sockaddr_in *rt_mask = (struct sockaddr_in *)&route.rt_genmask;
+            rt_mask->sin_family = AF_INET;
+            rt_mask->sin_addr.s_addr = INADDR_ANY;
+
+            route.rt_flags = RTF_UP | RTF_GATEWAY;
+            route.rt_dev = "eth0";
+
+            if (ioctl(rt_sockfd, SIOCADDRT, &route) < 0) {
+                /* EEXIST means route already exists — not an error */
+                if (errno != EEXIST) {
+                    perror("configure_static_network: SIOCADDRT");
+                }
+            }
+            close(rt_sockfd);
+        }
+    }
+
+    /* Write /etc/resolv.conf */
+    if (dns_servers) {
+        if (mkdir("/etc", 0755) < 0 && errno != EEXIST) {
+            perror("configure_static_network: mkdir(/etc)");
+            goto cleanup;
+        }
+
+        FILE *resolv = fopen("/etc/resolv.conf", "w");
+        if (resolv) {
+            fprintf(resolv, "# Generated by libkrun init (next-mode)\n");
+            char *dns_token = strtok(dns_servers, " ");
+            while (dns_token) {
+                fprintf(resolv, "nameserver %s\n", dns_token);
+                dns_token = strtok(NULL, " ");
+            }
+            fclose(resolv);
+            printf("configure_static_network: wrote /etc/resolv.conf\n");
+        } else {
+            perror("configure_static_network: fopen(/etc/resolv.conf)");
+        }
+    }
+
+    printf("configure_static_network: eth0 configured with IP %s\n", ip_cidr);
+    ret = 0;
+
+cleanup:
+    free(data);
+    free(ip_cidr);
+    free(gateway);
+    free(dns_servers);
+    return ret;
+}
 #endif
 
