# =============================================================================
# Shared base image for nanosandbox agent containers.
#
# Pure installation base: contains ONLY the system packages needed to install
# and run the agent CLIs. No user/group, no working directory, and no start
# command — sandbox setup (mounts, network, console) happens at the microVM
# layer and agent config is delivered via virtiofs mounts at boot.
# =============================================================================
FROM node:25-slim

LABEL org.opencontainers.image.source="https://github.com/nanosandboxai/nanosandbox"
LABEL org.opencontainers.image.description="Shared base image for nanosandbox agent containers"
LABEL org.opencontainers.image.licenses="MIT"

# Minimal system dependencies for the agent CLIs and their installers.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Python 3 + uv/uvx (runtime for Python-based MCP servers like mcp-server-fetch)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# Hardening: strip setuid/setgid bits on all binaries (the microVM boundary
# is the security model; setuid binaries are unnecessary inside it).
RUN find / -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true
