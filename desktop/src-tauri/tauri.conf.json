{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nanosb Desktop",
  "version": "0.1.0",
  "identifier": "ai.nanosandbox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nanosb Desktop",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "../design/mockup/assets/logo.png"
    ]
  }
}
